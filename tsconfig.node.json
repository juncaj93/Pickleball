{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "dev", "tests", "server", "shared", "src/pages/admin/todo.ts", "src/pages/admin/textMenu.ts", "src/pages/admin/suggestions.ts", "src/demo/sandbox.ts", "src/livecore.ts", "src/celebrate.ts", "src/optimistic.ts"]
}
