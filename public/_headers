/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'

# Zip 12 (item 3): built files under /assets/ carry a fingerprint of their contents in their name (index-D4Xhzfe8.js), so a
# new build always has new names. A phone can keep them for a year and never ask again. The page itself, /theme.js, the
# icons and every /api answer keep today's rules (the page and icons: ask again every time; /api: never stored). Zip 44 changed that
# for four small files, see the end of this file.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Zip 44 (speed leftovers): four small files that are NOT fingerprinted and that every open of the page asked the network about
# (a "has it changed?" trip each time, theme.js BEFORE the page can draw): the light/dark script, the header logo, the Christmas
# logo and the tab icon. A phone now keeps each for a day. Anything that changes inside a day must get a NEW file name (as the
# built files do), or phones show the old one until the day ends. The page itself ("/"), the other icons, the manifest and every
# /api answer keep their rules (ask again each time; /api: never stored). To undo: delete the four blocks below and deploy.
/theme.js
  Cache-Control: public, max-age=86400
/logo.png
  Cache-Control: public, max-age=86400
/logo-xmas.png
  Cache-Control: public, max-age=86400
/favicon-32.png
  Cache-Control: public, max-age=86400
