{
  "name": "pickleball-club",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "node e2e/run.cjs",
    "db:migrate:remote": "wrangler d1 migrations apply pickleball --remote",
    "deploy": "npm run build && wrangler pages deploy dist --project-name pickleball-club"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7",
    "wrangler": "4.153.0"
  }
}
